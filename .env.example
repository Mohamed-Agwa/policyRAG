# Copy to .env and fill in your key:  cp .env.example .env
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Models (Groq free plan)
LLM_MODEL=openai/gpt-oss-120b
JUDGE_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Retrieval
TOP_K=4
FETCH_K=10
USE_RERANKER=true
MIN_RELEVANCE=0.30

# Chunking (re-run `python -m rag.ingest` after changing these)
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# Output limits
MAX_TOKENS=1024
MAX_ANSWER_WORDS=180

# Cache LLM responses on disk (saves Groq quota)
USE_LLM_CACHE=true

SEED=42
